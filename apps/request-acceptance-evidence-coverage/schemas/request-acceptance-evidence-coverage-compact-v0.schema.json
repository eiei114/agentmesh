{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh.local/schemas/request-acceptance-evidence-coverage-compact-v0.schema.json",
  "title": "Request Acceptance Evidence Coverage Compact Output v0",
  "description": "Deterministic per-criterion coverage and bounded field-path findings; failures never include a partial report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_version", "valid", "coverage", "error_count", "errors"],
  "properties": {
    "schema_version": { "const": "request-acceptance-evidence-coverage-compact.v0" },
    "app_version": { "const": "request-acceptance-evidence-coverage.v0" },
    "valid": { "type": "boolean" },
    "coverage": { "anyOf": [{ "$ref": "#/$defs/coverage" }, { "type": "null" }] },
    "error_count": { "type": "integer", "enum": [0, 1] },
    "errors": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } } },
      "then": { "properties": { "coverage": { "$ref": "#/$defs/coverage" }, "error_count": { "const": 0 }, "errors": { "maxItems": 0 } } },
      "else": { "properties": { "coverage": { "type": "null" }, "error_count": { "const": 1 }, "errors": { "minItems": 1, "maxItems": 1 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "verdict", "evidence_ids"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 128 },
        "verdict": { "enum": ["covered", "uncovered"] },
        "evidence_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ev_[a-z0-9][a-z0-9._-]{0,59}$", "maxLength": 63 }
        }
      },
      "oneOf": [
        { "properties": { "verdict": { "const": "covered" }, "evidence_ids": { "minItems": 1 } } },
        { "properties": { "verdict": { "const": "uncovered" }, "evidence_ids": { "maxItems": 0 } } }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path"],
      "properties": {
        "code": {
          "enum": [
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_CRITERION_NO_EVIDENCE",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_CRITERION_INDEX_OUT_OF_RANGE",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_DUPLICATE_EVIDENCE_ID",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_EVIDENCE_SCHEMA_VERSION_UNSUPPORTED"
          ]
        },
        "path": { "type": "string", "pattern": "^\\$\\.[a-z_]+(\\[[0-9]+\\])?(\\.[a-z_]+(\\[[0-9]+\\])?)*$", "maxLength": 128 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_version", "scope", "request_digest", "verdict", "uncovered_criterion_ordinals", "reason_code", "evidence_inventory_sha256", "criteria", "finding_count", "findings", "findings_truncated", "omitted_finding_count"],
      "properties": {
        "schema_version": { "const": "acceptance-evidence-coverage.v0" },
        "contract_version": { "const": "acceptance-evidence-coverage.v0" },
        "scope": { "type": "string", "pattern": "^agentmesh:[a-z0-9][a-z0-9:._-]{0,117}$", "maxLength": 128 },
        "request_digest": { "$ref": "#/$defs/sha256" },
        "verdict": { "enum": ["covered", "uncovered"] },
        "uncovered_criterion_ordinals": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 128 }
        },
        "reason_code": { "enum": ["none", "acceptance_criteria_uncovered"] },
        "evidence_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "criteria": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/criterion_result" } },
        "finding_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "findings": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/finding" } },
        "findings_truncated": { "type": "boolean" },
        "omitted_finding_count": { "type": "integer", "minimum": 0, "maximum": 16768 }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "covered" } } },
          "then": { "properties": { "uncovered_criterion_ordinals": { "maxItems": 0 }, "reason_code": { "const": "none" } } }
        },
        {
          "if": { "properties": { "verdict": { "const": "uncovered" } } },
          "then": { "properties": { "uncovered_criterion_ordinals": { "minItems": 1 }, "reason_code": { "const": "acceptance_criteria_uncovered" } } }
        },
        {
          "if": { "properties": { "findings_truncated": { "const": true } } },
          "then": { "properties": { "omitted_finding_count": { "minimum": 1 } } },
          "else": { "properties": { "omitted_finding_count": { "const": 0 } } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path"],
      "properties": {
        "code": {
          "enum": [
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_INPUT_INVALID",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_INPUT_TOO_LARGE",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_SCHEMA_VERSION_UNSUPPORTED",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_CONTRACT_VERSION_UNSUPPORTED",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_REQUEST_SCHEMA_VERSION_UNSUPPORTED",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_REQUEST_SUMMARY_INVALID",
            "AGENTMESH_REQUEST_ACCEPTANCE_EVIDENCE_COVERAGE_REQUEST_CRITERIA_REQUIRED"
          ]
        },
        "path": { "type": "string", "maxLength": 128 }
      }
    }
  }
}
