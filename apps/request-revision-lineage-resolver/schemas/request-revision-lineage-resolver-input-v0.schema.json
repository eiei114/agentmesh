{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh.local/schemas/request-revision-lineage-resolver-input-v0.schema.json",
  "title": "Request Revision Lineage Resolver Input v0",
  "description": "A bounded list of validated revision summaries for one request scope plus at most one adapter materialization reference digest. No tracker fields, credentials, or free-form command strings are part of the contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "scope_key", "revisions", "materialization_reference_digest"],
  "properties": {
    "schema_version": { "const": "request-revision-lineage-input.v0" },
    "contract_version": { "const": "request-revision-lineage.v0" },
    "scope_key": { "$ref": "#/$defs/scope_key" },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision_id", "scope_key", "digest", "supersedes"],
        "properties": {
          "revision_id": { "$ref": "#/$defs/revision_id" },
          "scope_key": { "$ref": "#/$defs/scope_key" },
          "digest": { "$ref": "#/$defs/digest" },
          "supersedes": {
            "type": "array",
            "maxItems": 1,
            "items": { "$ref": "#/$defs/revision_id" }
          }
        }
      }
    },
    "materialization_reference_digest": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
    }
  },
  "$defs": {
    "scope_key": { "type": "string", "pattern": "^[a-z0-9_-]+(:[a-z0-9_-]+)*$", "maxLength": 96 },
    "revision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$", "maxLength": 64 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
