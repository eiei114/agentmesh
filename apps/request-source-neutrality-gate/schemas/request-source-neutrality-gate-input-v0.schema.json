{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh.local/schemas/request-source-neutrality-gate-input-v0.schema.json",
  "title": "Request Source Neutrality Gate Input v0",
  "description": "One validated request source summary as a bounded list of path/value fields. No tracker fields, credentials, or free-form command strings are part of the contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "source"],
  "properties": {
    "schema_version": { "const": "request-source-neutrality-input.v0" },
    "contract_version": { "const": "request-source-neutrality.v0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fields"],
      "properties": {
        "schema_version": { "const": "request-source-neutrality-source.v0" },
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$", "maxLength": 96 },
              "value": { "type": "string", "maxLength": 4096 }
            }
          }
        }
      }
    }
  }
}
