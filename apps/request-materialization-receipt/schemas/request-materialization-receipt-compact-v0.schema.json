{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh.local/schemas/request-materialization-receipt-compact-v0.schema.json",
  "title": "Request Materialization Receipt Compact Output v0",
  "description": "Deterministic bounded correspondence receipt or normalized failure. Failed inputs never return partial receipt fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "valid", "receipt", "error_count", "errors"],
  "properties": {
    "schema_version": { "const": "request-materialization-receipt-compact.v0" },
    "valid": { "type": "boolean" },
    "receipt": { "anyOf": [{ "$ref": "#/$defs/receipt" }, { "type": "null" }] },
    "error_count": { "type": "integer", "minimum": 0 },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error_record" } }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_version", "contract_version", "verdict", "fields", "reason_codes"],
      "properties": {
        "receipt_version": { "const": "request-materialization-receipt.v0" },
        "contract_version": { "const": "agentmesh-request-materialization-receipt.v0" },
        "verdict": { "enum": ["corresponded", "drifted"] },
        "fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/field_result" }
        },
        "reason_codes": { "type": "array", "items": { "$ref": "#/$defs/reason_code" } }
      }
    },
    "field_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "ordinal", "compared_values_digest", "code"],
      "properties": {
        "field": { "enum": ["scope_key", "request_kind", "title_digest", "criteria_count", "admission_verdict", "source_digest", "artifact_digest"] },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 7 },
        "compared_values_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "code": { "enum": ["matched", "scope_key_mismatch", "request_kind_mismatch", "title_digest_mismatch", "criteria_count_mismatch", "admission_not_admitted", "source_digest_mismatch", "artifact_digest_recorded"] }
      }
    },
    "reason_code": {
      "enum": ["scope_key_mismatch", "request_kind_mismatch", "title_digest_mismatch", "criteria_count_mismatch", "admission_not_admitted", "source_digest_mismatch"]
    },
    "error_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["INPUT_TOO_LARGE", "MALFORMED_INPUT", "UNSUPPORTED_SCHEMA_VERSION", "UNSUPPORTED_CONTRACT_VERSION", "REQUIRED_FIELD_MISSING", "INVALID_FIELD", "CROSS_SCOPE_INPUT"] }
      }
    }
  }
}
